# Plantilla de variables de entorno para el stack local.
# Uso:
#   cp .env.example .env
#   completar los valores vacíos y luego: docker compose up --build -d
#
# .env NO se versiona (ver .gitignore). Nunca subir valores reales al repo.

# ── Base de datos PostgreSQL ────────────────────────────────────
POSTGRES_USER=retail_user
POSTGRES_PASSWORD=
ORDERS_DB=orders

# ── Panel de administración ─────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Secreto de firma de los JWT del admin. Mínimo 32 caracteres.
# Generar con: openssl rand -hex 32
ADMIN_JWT_SECRET=
